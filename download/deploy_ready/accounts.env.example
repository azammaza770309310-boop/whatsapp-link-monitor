# ============================================================
# WhatsApp/Telegram Link Monitor - Environment Configuration
# ============================================================
# Copy this file to accounts.env and fill in your real values.
# NEVER commit accounts.env to git (it is in .gitignore).
# ============================================================

# Telegram API credentials (from https://my.telegram.org)
API_ID=YOUR_API_ID_HERE
API_HASH=YOUR_API_HASH_HERE

# User account (for monitoring)
PHONE=+YOUR_PHONE_NUMBER

# Bot token (from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Destination channel ID (starts with -100)
# Run setup_v6.py locally to discover this
CHANNEL_ID=-100XXXXXXXXXX

# Owner ID (optional - restricts commands to specific user)
# Get your ID from @userinfobot
OWNER_ID=

# Logging
LOG_LEVEL=INFO

# History Scan Settings
HISTORY_MAX_PER_CHAT=500
HISTORY_BATCH_SIZE=5
HISTORY_SKIP_CHANNEL_POSTS=false

# Startup scan (None/7/30/60/90)
STARTUP_SCAN_DAYS=None

# String Session (REQUIRED for cloud deployment - Render/Railway)
# Get this by running export_session.py locally
USER_SESSION_STRING=

# Supabase (persistent storage for production)
SUPABASE_URL=
SUPABASE_KEY=

# AI Provider Keys (multi-key fallback - rotate on 429/401/403/404)
OPENAI_API_KEY=
OPENAI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=llama-3.3-70b-versatile
AI_KEY_2=
AI_URL_2=https://api.groq.com/openai/v1/chat/completions
AI_MODEL_2=llama-3.3-70b-versatile
# AI_KEY_3 through AI_KEY_9 supported

# Proxy (optional - for blocked networks)
# Format: socks5:host:port or http:host:port
PROXY=
